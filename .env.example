# ============ Server ============
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- LLM (all optional; fallback chain: Anthropic -> OpenAI -> Groq -> Ollama) ---
# Free local option: install Ollama (https://ollama.com) and
#   run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Groq free tier (https://console.groq.com, no credit card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings ---
# huggingface-api = HF Inference API (free key, low RAM - use on Railway/Render)
# hf-local = Transformers.js on server (no key, but needs ~200MB+ RAM)
# openai   = requires OPENAI_API_KEY
EMBEDDING_PROVIDER=huggingface-api
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Pinecone free tier, no credit card) ---
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX=codebase-assistant
PINECONE_ENVIRONMENT=us-east-1

# --- GitHub ingestion ---
GITHUB_TOKEN=
MAX_FILE_BYTES=512000
MAX_FILES=2000

# ============ Client ============
NEXT_PUBLIC_API_URL=http://localhost:4000
