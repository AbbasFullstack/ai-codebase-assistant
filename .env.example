# ============ Server ============
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- LLM (all optional; fallback chain: Anthropic -> OpenAI -> Ollama) ---
# Free local option: install Ollama (https://ollama.com) and
#   run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
# hf-local = FREE (Transformers.js, no API key, runs on server)
# openai   = requires OPENAI_API_KEY
EMBEDDING_PROVIDER=hf-local
HF_EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB (Pinecone free tier, no credit card) ---
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX=codebase-assistant
PINECONE_ENVIRONMENT=us-east-1

# --- GitHub ingestion ---
GITHUB_TOKEN=
MAX_FILE_BYTES=512000
MAX_FILES=2000

# ============ Client ============
NEXT_PUBLIC_API_URL=http://localhost:4000
